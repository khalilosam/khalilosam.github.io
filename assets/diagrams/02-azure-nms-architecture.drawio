        </mxCell>

        <!-- Column 1: Client & Presentation Tier -->
        <mxCell id="col1_bg" value="TIER 1: PRESENTATION &amp; INGRESS LAYER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;fontColor=#334155;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;fontFamily=Segoe UI;" vertex="1" parent="1">
