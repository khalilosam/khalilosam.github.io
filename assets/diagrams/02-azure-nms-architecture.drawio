        <mxCell id="title_text" value="TELECOM NETWORK MANAGEMENT SYSTEM (NMS) — MICROSOFT AZURE ARCHITECTURE" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#FFFFFF;fontSize=20;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="70" y="32" width="950" height="35" as="geometry" />
        </mxCell>
        <mxCell id="subtitle_text" value="Production 3-Tier Enterprise Cloud Architecture | Provisioned via Terraform IaC | Automated with Azure DevOps &amp; GitHub Actions | Zero-Trust Private Connectivity" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#94A3B8;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="70" y="65" width="1050" height="25" as="geometry" />
