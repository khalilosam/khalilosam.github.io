<mxfile host="app.diagrams.net" modified="2026-10-31T15:00:00.000Z" agent="Antigravity Architecture Designer" version="21.6.8" type="device">
  <diagram id="cicd-pipeline-flow" name="CI/CD Pipeline Architecture">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title Banner -->
        <mxCell id="cicd_title_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#1E293B;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1520" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cicd_title_text" value="ENTERPRISE CI/CD PIPELINE ARCHITECTURE (AZURE DEVOPS &amp; GITHUB ACTIONS)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#FFFFFF;fontSize=20;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="70" y="32" width="1050" height="35" as="geometry" />
        </mxCell>
        <mxCell id="cicd_subtitle_text" value="Continuous Integration &amp; Continuous Deployment Flow | YAML Multi-Stage Pipelines | Branch Policies | Automated Build, Test &amp; Deployment to Azure Linux &amp; Storage" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#94A3B8;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="70" y="65" width="1100" height="25" as="geometry" />
        </mxCell>
        <mxCell id="cicd_author_badge" value="Designed by: Osama Khalil&#xa;Senior DevOps Engineer | CI/CD Specialist" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#0284C7;fontColor=#38BDF8;fontSize=11;align=center;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="1230" y="35" width="300" height="60" as="geometry" />
        </mxCell>

        <!-- Canvas Background -->
        <mxCell id="cicd_canvas" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="1520" height="830" as="geometry" />
        </mxCell>

        <!-- Section 1: Developer Inner Loop & Branching -->
        <mxCell id="sec1_box" value="PHASE 1: SOURCE CONTROL &amp; GOVERNANCE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;fontColor=#334155;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=15;spacingTop=8;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="65" y="160" width="460" height="760" as="geometry" />
        </mxCell>

        <!-- 1.1 Developer -->
        <mxCell id="dev_card" value="&lt;b&gt;1. Developer Workstation&lt;/b&gt;&lt;br&gt;&lt;font color='#475569'&gt;Local Environment (Linux / VS Code)&lt;/font&gt;&lt;br&gt;• Python FastAPI development&lt;br&gt;• Frontend UI updates&lt;br&gt;• Local unit tests &amp;amp; linters&lt;br&gt;• Signed Git commits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;align=left;spacingLeft=12;fontFamily=Segoe UI;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="210" width="410" height="100" as="geometry" />
        </mxCell>

        <!-- 1.2 Feature Branch -->
        <mxCell id="branch_card" value="&lt;b&gt;2. Git Feature Branch&lt;/b&gt;&lt;br&gt;&lt;font color='#0284C7'&gt;Branch: feat/nms-api-endpoint&lt;/font&gt;&lt;br&gt;• Isolated feature branch branched from `main`&lt;br&gt;• Modular commits &amp;amp; meaningful messages&lt;br&gt;• Remote push to Azure Repos / GitHub" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;align=left;spacingLeft=12;fontFamily=Segoe UI;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="340" width="410" height="90" as="geometry" />
        </mxCell>

        <!-- 1.3 Pull Request -->
        <mxCell id="pr_card" value="&lt;b&gt;3. Pull Request (PR)&lt;/b&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;Target: main branch&lt;/font&gt;&lt;br&gt;• PR description with linked JIRA tickets&lt;br&gt;• Automated PR trigger fire for CI validation&lt;br&gt;• Diff inspection &amp;amp; static change analysis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;align=left;spacingLeft=12;fontFamily=Segoe UI;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="460" width="410" height="90" as="geometry" />
        </mxCell>

        <!-- 1.4 Code Review & Branch Policies -->
        <mxCell id="policy_card" value="&lt;b&gt;4. Code Review &amp;amp; Branch Policies&lt;/b&gt;&lt;br&gt;&lt;font color='#DC2626'&gt;Enforced Branch Protection Gates&lt;/font&gt;&lt;br&gt;✔ Minimum 2 peer code reviews approved&lt;br&gt;✔ Automated build &amp;amp; test pipeline passed&lt;br&gt;✔ All comment threads resolved&lt;br&gt;✔ No direct push to main permitted&lt;br&gt;✔ Shift-left security scan clean" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7F1D1D;fontSize=11;align=left;spacingLeft=12;fontFamily=Segoe UI;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="580" width="410" height="130" as="geometry" />
        </mxCell>

        <!-- Git Merge to Main -->
        <mxCell id="merge_card" value="&lt;b&gt;Git Merge to main Branch&lt;/b&gt;&lt;br&gt;Trunk-based single source of truth triggers deployment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#14532D;fontSize=11;align=center;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="90" y="740" width="410" height="50" as="geometry" />
        </mxCell>

        <mxCell id="arr_dev_branch" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#0284C7;strokeWidth=2;" edge="1" parent="1" source="dev_card" target="branch_card" />
        <mxCell id="arr_branch_pr" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#0284C7;strokeWidth=2;" edge="1" parent="1" source="branch_card" target="pr_card" />
        <mxCell id="arr_pr_policy" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#7C3AED;strokeWidth=2;" edge="1" parent="1" source="pr_card" target="policy_card" />
        <mxCell id="arr_policy_merge" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#DC2626;strokeWidth=2;" edge="1" parent="1" source="policy_card" target="merge_card" />

        <!-- Section 2: Continuous Integration (CI) Pipeline -->
        <mxCell id="sec2_box" value="PHASE 2: CONTINUOUS INTEGRATION (CI PIPELINE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#0284C7;strokeWidth=1;fontColor=#0369A1;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=15;spacingTop=8;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="555" y="160" width="440" height="760" as="geometry" />
        </mxCell>

        <!-- Pipeline Orchestrator -->
        <mxCell id="orchestrator_card" value="&lt;b&gt;5. CI/CD Orchestrator (YAML Pipelines)&lt;/b&gt;&lt;br&gt;&lt;font color='#0284C7'&gt;Azure DevOps Pipelines / GitHub Actions&lt;/font&gt;&lt;br&gt;Configuration as Code: `azure-pipelines.yml`" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=2;fontColor=#0F172A;fontSize=12;align=center;fontFamily=Segoe UI;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="580" y="210" width="390" height="70" as="geometry" />
        </mxCell>

        <!-- Stage 1: Lint & Code Quality -->
        <mxCell id="ci_stage1" value="&lt;b&gt;6.1 Lint &amp;amp; Code Quality Analysis&lt;/b&gt;&lt;br&gt;• Python Flake8 &amp;amp; Black formatting&lt;br&gt;• YAML syntax linting (yamllint)&lt;br&gt;• Terraform fmt &amp;amp; tflint checks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;align=left;spacingLeft=12;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="580" y="310" width="390" height="80" as="geometry" />
        </mxCell>

        <!-- Stage 2: Automated Testing -->
        <mxCell id="ci_stage2" value="&lt;b&gt;6.2 Automated Build &amp;amp; Unit Tests&lt;/b&gt;&lt;br&gt;• pytest suite for FastAPI telecom endpoints&lt;br&gt;• Mock database connectivity tests&lt;br&gt;• Code coverage report generation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;align=left;spacingLeft=12;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="580" y="420" width="390" height="80" as="geometry" />
        </mxCell>

        <!-- Stage 3: IaC & Security Scanning -->
        <mxCell id="ci_stage3" value="&lt;b&gt;6.3 Shift-Left Security Scans&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Checkov &amp;amp; tfsec:&lt;/b&gt; IaC vulnerability scanning&lt;br&gt;• Prevent unencrypted resources &amp;amp; wide-open NSGs&lt;br&gt;• Secret scanning (credential leak prevention)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;align=left;spacingLeft=12;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="580" y="530" width="390" height="80" as="geometry" />
        </mxCell>

        <!-- Stage 4: Package Artifacts -->
        <mxCell id="ci_stage4" value="&lt;b&gt;6.4 Artifact Packaging &amp;amp; Publishing&lt;/b&gt;&lt;br&gt;• Build production frontend bundle (HTML/JS)&lt;br&gt;• Package FastAPI application code &amp;amp; dependencies&lt;br&gt;• Publish immutable drop to Azure Pipeline Artifacts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;align=left;spacingLeft=12;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="580" y="640" width="390" height="80" as="geometry" />
        </mxCell>

        <mxCell id="arr_orch_s1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#0078D4;strokeWidth=2;" edge="1" parent="1" source="orchestrator_card" target="ci_stage1" />
        <mxCell id="arr_s1_s2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#0284C7;strokeWidth=2;" edge="1" parent="1" source="ci_stage1" target="ci_stage2" />
        <mxCell id="arr_s2_s3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#0284C7;strokeWidth=2;" edge="1" parent="1" source="ci_stage2" target="ci_stage3" />
        <mxCell id="arr_s3_s4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#D97706;strokeWidth=2;" edge="1" parent="1" source="ci_stage3" target="ci_stage4" />

        <!-- Arrow from Merge to Orchestrator -->
        <mxCell id="arr_merge_to_ci" value="Triggers CI" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#16A34A;strokeWidth=2.5;fontColor=#15803D;fontSize=10;fontStyle=1;" edge="1" parent="1" source="merge_card" target="orchestrator_card" />

        <!-- Section 3: Continuous Deployment (CD) & Azure Target Environments -->
        <mxCell id="sec3_box" value="PHASE 3: CONTINUOUS DEPLOYMENT (CD) &amp; AZURE TARGETS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1;fontColor=#065F46;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=15;spacingTop=8;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="1025" y="160" width="510" height="760" as="geometry" />
        </mxCell>

        <!-- CD Release Pipeline -->
        <mxCell id="cd_release_card" value="&lt;b&gt;7. CD Release Pipeline (Multi-Stage Promotion)&lt;/b&gt;&lt;br&gt;&lt;font color='#059669'&gt;Automated Deployment Agent via Service Principal&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=2;fontColor=#0F172A;fontSize=12;align=center;fontFamily=Segoe UI;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1050" y="210" width="460" height="60" as="geometry" />
        </mxCell>

        <!-- Target Environment: DEV -->
        <mxCell id="cd_dev" value="&lt;b&gt;8.1 Dev Environment Deployment&lt;/b&gt;&lt;br&gt;• Automated trigger upon CI completion&lt;br&gt;• Upload frontend static files to Azure Storage `$web`&lt;br&gt;• Deploy backend code to Linux VM &amp;amp; systemd restart&lt;br&gt;• Automated smoke tests: health endpoint probe (`/healthz`)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;align=left;spacingLeft=12;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="1050" y="300" width="460" height="95" as="geometry" />
        </mxCell>

        <!-- Target Environment: STAGE -->
        <mxCell id="cd_stage" value="&lt;b&gt;8.2 Stage (Pre-Prod) Deployment&lt;/b&gt;&lt;br&gt;• Automated deployment to isolated staging environment&lt;br&gt;• PostgreSQL database schema verification&lt;br&gt;• End-to-end NMS telemetry &amp;amp; performance validation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;align=left;spacingLeft=12;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="1050" y="420" width="460" height="85" as="geometry" />
        </mxCell>

        <!-- Approval Gate for Prod -->
        <mxCell id="prod_gate" value="&lt;b&gt;Manual Approval &amp;amp; Sign-off Gate&lt;/b&gt;&lt;br&gt;Mandatory Operations / Lead sign-off before Production release" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=1.5;fontColor=#92400E;fontSize=11;align=center;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="1050" y="530" width="460" height="45" as="geometry" />
        </mxCell>

        <!-- Target Environment: PROD -->
        <mxCell id="cd_prod" value="&lt;b&gt;8.3 Production Azure Environment Deployment&lt;/b&gt;&lt;br&gt;&lt;font color='#065F46'&gt;Live Telecom NMS Infrastructure&lt;/font&gt;&lt;br&gt;• Frontend sync to Production Azure Storage Container&lt;br&gt;• Zero-downtime rolling reload on Linux VM (Nginx + FastAPI)&lt;br&gt;• Database migration with rollback safety&lt;br&gt;• Azure Monitor &amp;amp; Prometheus active telemetry checks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#059669;strokeWidth=2;fontColor=#064E3B;fontSize=11;align=left;spacingLeft=12;fontFamily=Segoe UI;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1050" y="600" width="460" height="110" as="geometry" />
        </mxCell>

        <!-- Runtime Summary Footer -->
        <mxCell id="cd_runtime_box" value="&lt;b&gt;Technologies:&lt;/b&gt; Azure DevOps Pipelines | GitHub Actions | YAML | Git | Terraform | Linux (RHEL/Ubuntu) | Nginx | FastAPI | PostgreSQL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=center;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="1050" y="735" width="460" height="50" as="geometry" />
        </mxCell>

        <mxCell id="arr_pkg_to_cd" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#16A34A;strokeWidth=2.5;" edge="1" parent="1" source="ci_stage4" target="cd_release_card" />
        <mxCell id="arr_cd_dev" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#059669;strokeWidth=2;" edge="1" parent="1" source="cd_release_card" target="cd_dev" />
        <mxCell id="arr_dev_stage" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#10B981;strokeWidth=2;" edge="1" parent="1" source="cd_dev" target="cd_stage" />
        <mxCell id="arr_stage_gate" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#0284C7;strokeWidth=2;" edge="1" parent="1" source="cd_stage" target="prod_gate" />
        <mxCell id="arr_gate_prod" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#F59E0B;strokeWidth=2;" edge="1" parent="1" source="prod_gate" target="cd_prod" />

